# Copy this file to .env and fill in values as needed.
# Never commit a real .env file with real secrets.

# Server
PORT=3000
NODE_ENV=development

# CORS — origin(s) allowed to call this API from a browser (e.g. the
# hackathon frontend, on a different origin/port). "*" (default) allows any
# origin, which is fine for demo purposes. For a specific frontend origin,
# set one URL, or a comma-separated list of URLs, e.g.:
#   CORS_ORIGIN=https://your-frontend.example.com
#   CORS_ORIGIN=http://localhost:5173,https://your-frontend.example.com
CORS_ORIGIN=*

# AI provider for the interview intelligence engine (question generation +
# answer evaluation). "mock" needs no key and is fully deterministic — good
# for local dev and the automated tests. Switch to "anthropic" or "groq" for
# real model calls.
AI_PROVIDER=mock
# Required only when AI_PROVIDER=anthropic:
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-6
# Required only when AI_PROVIDER=groq:
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Memory provider for the Breeth-backed candidate memory layer. "mock"
# needs no key and is fully deterministic — good for local dev and the
# automated tests (npm run test:memory always forces mock regardless of
# this value). Switch to "breeth" for real persistent candidate memory.
MEMORY_PROVIDER=mock
# Required only when MEMORY_PROVIDER=breeth:
# Mint a `write`-scoped key at https://www.thebreeth.com/app -> API Keys.
# The plaintext key is shown exactly once — store it like any other secret.
# BREETH_API_KEY=ck_live_...
# BREETH_BASE_URL=https://api.thebreeth.com
# BREETH_GROUP_PREFIX=interviewer-os
# BREETH_EXTRACT_INTENT=false
# BREETH_TIMEOUT_MS=8000
